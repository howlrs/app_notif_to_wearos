# Copy to .env and replace these values before starting the registration API.
# Generate an API key with: openssl rand -hex 32
# Use the same key for wear-app/local.properties: siteAlert.apiKey
SITEALERT_API_KEY=replace-with-your-generated-key
SITEALERT_DB_PATH=data/sitealert.db
FIREBASE_PROJECT_ID=your-firebase-project-id
SITEALERT_FCM_TTL_SECONDS=300
SITEALERT_DAY_START_HOUR=4
SITEALERT_TIMEZONE=Asia/Tokyo

# FCM sending uses Application Default Credentials by default.
# Development only: optionally supply a command that prints an access token.
# SITEALERT_FCM_TOKEN_COMMAND='gcloud auth print-access-token --impersonate-service-account=fcm-sender@your-firebase-project-id.iam.gserviceaccount.com'
